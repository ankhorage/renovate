{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Devtools-owner dependency update policy for ankhorage/devtools."
  ],
  "extends": [
    "./default"
  ],
  "packageRules": [
    {
      "description": "Group dependencies owned and validated by the Devtools repository.",
      "matchManagers": [
        "bun"
      ],
      "matchFileNames": [
        "package.json"
      ],
      "enabled": true,
      "labels": [
        "dependencies",
        "renovate:automerge"
      ],
      "groupName": "Devtools-owned toolchain",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "separateMajorMinor": false
    },
    {
      "description": "Devtools consumes Bun runtime versions through the released Rules contract; Renovate must not overwrite owner-sync output.",
      "matchManagers": [
        "bun"
      ],
      "matchPackageNames": [
        "bun",
        "@types/bun"
      ],
      "matchFileNames": [
        "package.json"
      ],
      "enabled": false
    }
  ]
}
