{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": ["Devtools-owner dependency update policy for ankhorage/devtools."],
  "extends": ["./default"],
  "packageRules": [
    {
      "description": "Group dependencies owned and validated by the Devtools repository.",
      "matchManagers": ["bun"],
      "matchFileNames": ["package.json"],
      "enabled": true,
      "labels": ["dependencies", "renovate:automerge"],
      "groupName": "Devtools-owned toolchain",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "separateMajorMinor": false
    },
    {
      "description": "Devtools receives Bun versions via the Rules release, not direct Renovate updates.",
      "matchManagers": ["bun"],
      "matchPackageNames": ["bun", "@types/bun"],
      "matchFileNames": ["package.json"],
      "enabled": false
    }
  ]
}
