{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": ["Canonical dependency update policy for Ankhorage consumer repositories."],
  "extends": ["config:recommended", ":dependencyDashboard"],
  "enabledManagers": ["bun", "custom.regex"],
  "gitIgnoredAuthors": ["323340348+ankhorage-renovate-sync[bot]@users.noreply.github.com"],
  "labels": ["dependencies"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the current immutable Renovate synchronization workflow digest.",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/renovate\\.yml$/"],
      "matchStrings": [
        "uses:\\s+ankhorage/renovate/\\.github/workflows/changeset\\.yml@(?<currentDigest>[0-9a-f]{40})"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "ankhorage/renovate",
      "datasourceTemplate": "github-digest",
      "autoReplaceStringTemplate": "uses: ankhorage/renovate/.github/workflows/changeset.yml@{{{newDigest}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Disable dependency updates unless a later ownership rule explicitly enables them.",
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "description": "Automerge every validated npm release.",
      "matchDatasources": ["npm"],
      "enabled": true,
      "labels": ["dependencies", "renovate:automerge"],
      "rangeStrategy": "bump",
      "separateMajorMinor": false,
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Group Ankhorage library updates and propagate every release downstream.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@ankhorage/**"],
      "enabled": true,
      "labels": ["dependencies", "renovate:automerge"],
      "groupName": "Ankhorage libraries",
      "groupSlug": "ankhorage-libraries",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "separateMajorMinor": false
    },
    {
      "description": "Update the canonical Ankh CLI and Devtools provider as one toolchain.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@ankhorage/ankh", "@ankhorage/devtools"],
      "enabled": true,
      "labels": ["dependencies", "renovate:automerge"],
      "groupName": "Ankhorage CLI and Devtools toolchain",
      "groupSlug": "ankhorage-cli-and-devtools-toolchain",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "separateMajorMinor": false
    },
    {
      "description": "Keep canonical Devtools workflows under deterministic Devtools sync ownership.",
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        ".github/workflows/ci.yml",
        ".github/workflows/renovate.yml",
        ".github/workflows/release.yml"
      ],
      "enabled": false
    },
    {
      "description": "Update the immutable Renovate synchronization workflow before Devtools synchronization.",
      "matchDatasources": ["github-digest"],
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["ankhorage/renovate"],
      "matchFileNames": [".github/workflows/renovate.yml"],
      "enabled": true,
      "labels": ["dependencies", "renovate:automerge"],
      "groupName": "Ankhorage Renovate workflow",
      "groupSlug": "ankhorage-renovate-workflow",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ]
}
