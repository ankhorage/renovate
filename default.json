{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Canonical dependency update policy for Ankhorage consumer repositories."
  ],
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "enabledManagers": [
    "bun",
    "custom.regex"
  ],
  "gitIgnoredAuthors": [
    "323340348+ankhorage-renovate-sync[bot]@users.noreply.github.com"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "rebaseWhen": "behind-base-branch",
  "pruneStaleBranches": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the current immutable Renovate synchronization workflow digest.",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/renovate\\.yml$/"
      ],
      "matchStrings": [
        "uses:\\s+ankhorage/renovate/\\.github/workflows/changeset\\.yml@(?<currentDigest>[0-9a-f]{40})"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "ankhorage/renovate",
      "datasourceTemplate": "github-digest",
      "autoReplaceStringTemplate": "uses: ankhorage/renovate/.github/workflows/changeset.yml@{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "description": "Update the canonical Bun runtime literal in @ankhorage/rules-repository.",
      "managerFilePatterns": [
        "/^src\\/constants\\/repository\\.ts$/"
      ],
      "matchStrings": [
        "const BUN_VERSION = '(?<currentValue>[^']+)';"
      ],
      "depNameTemplate": "bun",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update the canonical Bun type version in @ankhorage/rules-repository.",
      "managerFilePatterns": [
        "/^src\\/constants\\/repository\\.ts$/"
      ],
      "matchStrings": [
        "const BUN_TYPES_VERSION = '(?<currentValue>[^']+)';"
      ],
      "depNameTemplate": "@types/bun",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Disable dependency updates unless a later ownership rule explicitly enables them.",
      "matchPackageNames": [
        "*"
      ],
      "enabled": false
    },
    {
      "description": "Automerge every validated npm release.",
      "matchDatasources": [
        "npm"
      ],
      "enabled": true,
      "labels": [
        "dependencies",
        "renovate:automerge"
      ],
      "rangeStrategy": "bump",
      "separateMajorMinor": false,
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": [
        "Bundle external npm updates into one integration lane per repository."
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "*"
      ],
      "enabled": true,
      "labels": [
        "dependencies",
        "renovate:automerge"
      ],
      "groupName": "External npm dependencies",
      "groupSlug": "external-npm-dependencies",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "separateMajorMinor": false
    },
    {
      "description": "Keep TypeScript on the latest currently compatible major line.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "Group Ankhorage library updates and propagate every release downstream.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@ankhorage/**"
      ],
      "enabled": true,
      "labels": [
        "dependencies",
        "renovate:automerge"
      ],
      "groupName": "Ankhorage libraries",
      "groupSlug": "ankhorage-libraries",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "separateMajorMinor": false
    },
    {
      "description": "Update the canonical Ankh CLI and Devtools provider as one toolchain.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@ankhorage/ankh",
        "@ankhorage/devtools"
      ],
      "enabled": true,
      "labels": [
        "dependencies",
        "renovate:automerge"
      ],
      "groupName": "Ankhorage CLI and Devtools toolchain",
      "groupSlug": "ankhorage-cli-and-devtools-toolchain",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "separateMajorMinor": false
    },
    {
      "description": "Keep canonical Devtools workflows under deterministic Devtools sync ownership.",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml",
        ".github/workflows/renovate.yml",
        ".github/workflows/release.yml"
      ],
      "enabled": false
    },
    {
      "description": "Update the immutable Renovate synchronization workflow before Devtools synchronization.",
      "matchDatasources": [
        "github-digest"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "ankhorage/renovate"
      ],
      "matchFileNames": [
        ".github/workflows/renovate.yml"
      ],
      "enabled": true,
      "labels": [
        "dependencies",
        "renovate:automerge"
      ],
      "groupName": "Ankhorage Renovate workflow",
      "groupSlug": "ankhorage-renovate-workflow",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Require deliberate React Native release-line upgrades.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "react-native"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Require deliberate Expo SDK major upgrades.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "expo",
        "expo-*"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Widen peer dependency compatibility instead of replacing the previously supported range.",
      "matchDatasources": [
        "npm"
      ],
      "matchDepTypes": [
        "peerDependencies"
      ],
      "rangeStrategy": "widen"
    },
    {
      "description": "Leave Studio Expo platform dependency versions to the Expo Runtime owner rollout.",
      "matchRepositories": [
        "ankhorage/studio"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@expo/**",
        "@types/node",
        "@types/react",
        "expo",
        "expo-*",
        "react",
        "react-dom",
        "react-native",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-web",
        "react-native-worklets",
        "typescript"
      ],
      "enabled": false
    },
    {
      "description": "Do not directly update Devtools-managed Bun runtime declarations in ordinary consumers.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "bun",
        "@types/bun"
      ],
      "enabled": false
    },
    {
      "description": "Update the Rules-owned Bun literals and matching owner manifest as one candidate for staged release.",
      "matchRepositories": [
        "ankhorage/rules-repository"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "bun",
        "@types/bun"
      ],
      "matchFileNames": [
        "package.json",
        "src/constants/repository.ts"
      ],
      "enabled": true,
      "labels": [
        "dependencies",
        "renovate:automerge"
      ],
      "groupName": "Canonical Bun runtime",
      "groupSlug": "canonical-bun-runtime",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "separateMajorMinor": false
    }
  ]
}
