{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": ["Canonical dependency update policy for Ankhorage consumer repositories."],
  "extends": ["config:recommended", ":dependencyDashboard"],
  "gitIgnoredAuthors": ["323340348+ankhorage-renovate-sync[bot]@users.noreply.github.com"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bootstrap the legacy consumer workflow to the released synchronization implementation.",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/renovate\\.yml$/"],
      "matchStrings": [
        "uses:\\s+ankhorage/renovate/\\.github/workflows/changeset\\.yml@(?<currentDigest>b7305e8f17f9b07238f6b827bbc9f866fd498a0f)"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "ankhorage/renovate",
      "datasourceTemplate": "github-digest",
      "autoReplaceStringTemplate": "uses: ankhorage/renovate/.github/workflows/changeset.yml@{{{newDigest}}}"
    }
  ],
  "packageRules": [
    {
      "description": "Disable dependency updates unless a later ownership rule explicitly enables them.",
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "description": "Automerge every validated npm patch release.",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["patch"],
      "enabled": true,
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Keep the canonical development toolchain under Devtools release ownership.",
      "matchPackageNames": [
        "bun",
        "@types/bun",
        "@types/node",
        "@eslint/**",
        "eslint",
        "eslint-*",
        "knip",
        "prettier",
        "prettier-*",
        "typescript",
        "typescript-eslint",
        "@typescript-eslint/**"
      ],
      "enabled": false
    },
    {
      "description": "Group Ankhorage library updates and propagate every release downstream.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@ankhorage/**"],
      "enabled": true,
      "groupName": "Ankhorage libraries",
      "groupSlug": "ankhorage-libraries",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Update the canonical Ankh CLI and Devtools provider as one toolchain.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@ankhorage/ankh", "@ankhorage/devtools"],
      "enabled": true,
      "groupName": "Ankhorage CLI and Devtools toolchain",
      "groupSlug": "ankhorage-cli-and-devtools-toolchain",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Require review for major CLI and Devtools toolchain upgrades.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@ankhorage/ankh", "@ankhorage/devtools"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Keep canonical Devtools workflows under deterministic Devtools sync ownership.",
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        ".github/workflows/ci.yml",
        ".github/workflows/renovate.yml",
        ".github/workflows/release.yml"
      ],
      "enabled": false
    },
    {
      "description": "Bootstrap the released Renovate synchronization workflow exactly once.",
      "matchDatasources": ["github-digest"],
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["ankhorage/renovate"],
      "matchFileNames": [".github/workflows/renovate.yml"],
      "enabled": true,
      "groupName": "Ankhorage Renovate workflow bootstrap",
      "groupSlug": "ankhorage-renovate-workflow-bootstrap",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    }
  ]
}
